<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>control_pkg</name>
  <version>0.0.1</version>
  <description>Control node interface for actuator package integration</description>
  <maintainer email="your_email@example.com">Edward Wang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  
  <!-- Reference to UCSD Robocar Actuator Package -->
  <!-- This node subscribes to /cmd_vel and interfaces with ucsd_robocar_actuator2_pkg -->
  <!-- The actual hardware control is handled by the actuator package -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

